<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same rule as souqi_backup_rules.xml, for cloud backup
     and for a phone-to-phone transfer. The Keystore key that wraps the
     card-code key stays on the old phone either way. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
