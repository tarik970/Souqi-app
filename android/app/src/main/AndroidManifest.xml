<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth receipt printer (Bluetooth Classic, serial port profile).
         Android 11 and older: install-time permissions, no location needed
         because the app only lists devices that are already paired. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+: runtime "Nearby devices" permissions. CONNECT lists the
         paired devices and opens the socket; SCAN is only needed to stop a
         running discovery before connecting and never derives location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- "Save to phone" on Android 9 and older only; Android 10+ writes to
         Downloads/Souqi through MediaStore with no storage permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The daily debt report (phase 4e). Android 13+: "Debt report ready"
         is a notification, asked for when the report is turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Offering Android's own "let Souqi run in the background?" dialog, so
         battery saving does not hold the report back for hours. Only ever
         shown after the app explains why; the user can say no. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- WorkManager (the report's scheduler) adds RECEIVE_BOOT_COMPLETED and
         its own boot receiver to keep the plan across reboots. No exact
         alarms: the report may come a little late, and the app catches up
         on its next start. -->

    <uses-feature android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- The camera (scanning the QR code / barcode on a prepaid card) is
         declared by the mobile_scanner plugin and asked for at the first
         scan; the app works without it. -->

    <!-- The two backup attributes keep the Keystore-bound card-code key out
         of Android's backups; see the comments in the two XML files. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/souqi_backup_rules"
        android:dataExtractionRules="@xml/souqi_data_extraction_rules"
        tools:targetApi="s">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Hands the staged invoice image/PDF (app cache, "share" folder)
             to WhatsApp through a content:// URI. A subclass, so it cannot
             clash with the FileProviders that plugins declare. -->
        <provider
            android:name=".SouqiFileProvider"
            android:authorities="${applicationId}.souqi.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/souqi_file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- "Send on WhatsApp": see which of the two apps is installed. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
</manifest>
